# Vault data must never be committed.
# Every .json and .csv is ignored by default; the sample fixture is re-allowed
# at the bottom, since in gitignore the last matching rule wins.
*.json
*.csv

# Bitwarden's own export filenames, and anything that looks like one
bitwarden_export*
*export*.json
*vault*.json
vault-deduped-*.json
vault-delete-list-*.csv

# Other credential-bearing formats, in case you ever add importers
*.1pux
*.opvault
*.kdbx
*.enc

# Editors, OS cruft, tooling
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
node_modules/
.env
.env.*

# The one file that is safe to commit: synthetic data only, no real credentials.
!example-vault.json
